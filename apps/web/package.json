{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:i18n && next build",
    "start": "next start",
    "lint": "eslint",
    "check:i18n": "node scripts/validate-catalogs.mjs",
