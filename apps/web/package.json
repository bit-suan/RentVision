  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "pannellum": "^2.5.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pannellum": "^2.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5"
  }
