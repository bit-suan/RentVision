# ==============================================================================
# RentVision Environment Variables Configuration Template
# Copy this file to .env or .env.local for local development.
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# AWS General Configuration
# ------------------------------------------------------------------------------
AWS_REGION=eu-west-1
AWS_ACCOUNT_ID=123456789012
CDK_DEFAULT_REGION=eu-west-1
CDK_DEFAULT_ACCOUNT=123456789012

# ------------------------------------------------------------------------------
# Frontend Application (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Optional: enable API-backed demo authentication outside localhost. The Render
# Blueprint sets this to "local". Leave unset to use Cognito when the
# NEXT_PUBLIC_COGNITO_* variables below are configured.
# NEXT_PUBLIC_AUTH_MODE=local

# Map Provider (e.g., OpenStreetMap standard or custom tile URL)
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Default Map Center (Addis Ababa, Ethiopia)
NEXT_PUBLIC_DEFAULT_LATITUDE=9.010793
NEXT_PUBLIC_DEFAULT_LONGITUDE=38.761252
NEXT_PUBLIC_DEFAULT_ZOOM=13

# ------------------------------------------------------------------------------
# Backend Service (services/api)
# ------------------------------------------------------------------------------
API_PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Locally the API defaults to local mode when DATA_STORE=memory, which enables
# development identity headers. Deployed environments must set this to "false".
# API_LOCAL_MODE=true

# HMAC-SHA256 secret for API-issued session tokens. If unset, the API creates an
# ephemeral secret and sessions reset on restart. Render generates this value.
# AUTH_TOKEN_SECRET=

# Base URL returned in local upload/download links. Defaults to
# RENDER_EXTERNAL_URL in production, then http://localhost:${PORT}.
# API_PUBLIC_BASE_URL=http://localhost:3001

# Amazon DynamoDB Tables
DYNAMODB_PROPERTIES_TABLE=rentvision-properties-dev
DYNAMODB_USERS_TABLE=rentvision-users-dev
DYNAMODB_LEASES_TABLE=rentvision-leases-dev

# DynamoDB Indexes
LISTINGS_GEO_INDEX_NAME=geoIndex
LISTINGS_STATUS_INDEX_NAME=statusIndex

# Amazon S3 Buckets
S3_PROPERTY_MEDIA_BUCKET=rentvision-property-media-dev
S3_LEASE_DOCUMENTS_BUCKET=rentvision-lease-documents-dev

# Amazon Cognito (populated after CDK deployment)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=eu-west-1_xxxxxxxxx
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_COGNITO_REGION=eu-west-1

# API Gateway (populated after CDK deployment)
# API_BASE_URL=https://xxxxxxxxxx.execute-api.eu-west-1.amazonaws.com

# ------------------------------------------------------------------------------
# Local Development AWS Profile
# ------------------------------------------------------------------------------
# AWS_PROFILE=rentvision-dev

# ------------------------------------------------------------------------------
# AI Service (services/ai)
# ------------------------------------------------------------------------------
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
AI_SERVICE_ENV=development
MAX_DOCUMENT_UPLOAD_MB=25

# Model Provider Configuration
# Optional: Set OPENAI_API_KEY (or AI_MODEL_API_KEY) for live AI listing extraction inference
OPENAI_API_KEY=your_openai_or_compatible_api_key_here
AI_MODEL_NAME=gpt-4o-mini
AI_MODEL_BASE_URL=https://api.openai.com/v1

# Optional: Gemini via its OpenAI-compatible endpoint. Used by the Render
# Blueprint when GEMINI_API_KEY is provided.
# GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Web AI Assistant Proxy (apps/web, server-only)
# ------------------------------------------------------------------------------
# The web app reads apps/web/.env* (not this root file). Set these in
# apps/web/.env.local for local development. Never prefix them with NEXT_PUBLIC_.
# Defaults to http://127.0.0.1:8000/api/v1/assistant/chat in development.
RENTVISION_AI_CHAT_URL=http://127.0.0.1:8000/api/v1/assistant/chat
RENTVISION_AI_CHAT_TIMEOUT_MS=20000
# Optional bearer token when the AI service is behind an authenticated gateway.
# RENTVISION_AI_CHAT_TOKEN=

# General assistant chat requires a live model provider. AI_USE_MOCK_CLIENT=true
# is intentionally not enough for the assistant endpoint; missing credentials
# return an honest error instead of a simulated answer.

# ------------------------------------------------------------------------------
# Render Blueprint Reference (render.yaml) - do not set these for local dev
# ------------------------------------------------------------------------------
# The Blueprint sets these automatically for the deployed services:
#
# Web:  NEXT_PUBLIC_API_BASE_URL=/api/v1
#       NEXT_PUBLIC_AUTH_MODE=local
#       API_INTERNAL_URL=<rentvision-api private host:port>
#       RENTVISION_AI_BASE_URL=<rentvision-ai private host:port>
# API:  DATA_STORE=memory
#       API_LOCAL_MODE=false
#       AUTH_TOKEN_SECRET=<generated by Render>
#       CORS_ALLOWED_ORIGINS=*
#       AI_SERVICE_HOST / AI_SERVICE_PORT=<rentvision-ai private host/port>
# AI:   GEMINI_API_KEY=<optional>
#       AI_MODEL_NAME=models/gemini-3.5-flash
#
# See docs/deployment-render.md for the full guide.
