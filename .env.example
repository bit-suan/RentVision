# ==============================================================================
# RentVision Environment Variables Configuration Template
# Copy this file to .env or .env.local for local development.
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# AWS General Configuration
# ------------------------------------------------------------------------------
AWS_REGION=eu-west-1
AWS_ACCOUNT_ID=123456789012
CDK_DEFAULT_REGION=eu-west-1
CDK_DEFAULT_ACCOUNT=123456789012

# ------------------------------------------------------------------------------
# Frontend Application (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Map Provider (e.g., OpenStreetMap standard or custom tile URL)
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Default Map Center (Addis Ababa, Ethiopia)
NEXT_PUBLIC_DEFAULT_LATITUDE=9.010793
NEXT_PUBLIC_DEFAULT_LONGITUDE=38.761252
NEXT_PUBLIC_DEFAULT_ZOOM=13

# ------------------------------------------------------------------------------
# Backend Service (services/api)
# ------------------------------------------------------------------------------
API_PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Amazon DynamoDB Tables
DYNAMODB_PROPERTIES_TABLE=rentvision-properties-dev
DYNAMODB_USERS_TABLE=rentvision-users-dev
DYNAMODB_LEASES_TABLE=rentvision-leases-dev

# DynamoDB Indexes
LISTINGS_GEO_INDEX_NAME=geoIndex
LISTINGS_STATUS_INDEX_NAME=statusIndex

# Amazon S3 Buckets
S3_PROPERTY_MEDIA_BUCKET=rentvision-property-media-dev
S3_LEASE_DOCUMENTS_BUCKET=rentvision-lease-documents-dev

# API Gateway (populated after CDK deployment)
# API_BASE_URL=https://xxxxxxxxxx.execute-api.eu-west-1.amazonaws.com

# ------------------------------------------------------------------------------
# Local Development AWS Profile
# ------------------------------------------------------------------------------
# AWS_PROFILE=rentvision-dev

# ------------------------------------------------------------------------------
# AI Service (services/ai)
# ------------------------------------------------------------------------------
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
AI_SERVICE_ENV=development
MAX_DOCUMENT_UPLOAD_MB=25

# Model Provider Configuration
# Optional: Set OPENAI_API_KEY (or AI_MODEL_API_KEY) for live AI listing extraction inference
OPENAI_API_KEY=your_openai_or_compatible_api_key_here
AI_MODEL_NAME=gpt-4o-mini
AI_MODEL_BASE_URL=https://api.openai.com/v1
